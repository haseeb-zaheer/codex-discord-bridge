# Discord bot token.
DISCORD_TOKEN=

# Comma-separated Discord user ids allowed to control the bot.
DISCORD_ALLOWED_USER_IDS=

# All codex -new folders must resolve inside this root.
CODEX_BRIDGE_ROOT=~/repositories

# Local bridge state and logs.
CODEX_BRIDGE_DB=./codex_bridge.db
CODEX_BRIDGE_LOG_DIR=./logs

# Codex execution defaults.
CODEX_BIN=codex
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_DEFAULT_MODEL=
